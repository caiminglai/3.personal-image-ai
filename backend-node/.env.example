# ===== Style AI 后端环境变量 =====

# 管理员密码（首次启动自动创建 admin 账号）
ADMIN_PASSWORD=your_password_here

# Flask/Express 通用密钥（Token 签名用）
SECRET_KEY=your_secret_key_at_least_16_chars

# 端口（与 Python 版保持一致）
PORT=5000

# CORS 允许的来源（逗号分隔，生产环境必须配置）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DashScope API（面容分析、虚拟试穿）
DASHSCOPE_API_KEY=

# LLM API（星座运势等创意文案生成）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-turbo

# 虚拟试穿 API
TRYON_API_URL=
TRYON_API_KEY=
TRYON_MODEL=

# 顾客临时数据过期时间（秒），默认 2 小时
CUSTOMER_DATA_TTL=7200
